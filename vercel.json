{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/en", "destination": "https://calcmoa-i18n.sjshin.workers.dev/en/" },
    { "source": "/ja", "destination": "https://calcmoa-i18n.sjshin.workers.dev/ja/" },
    { "source": "/fr", "destination": "https://calcmoa-i18n.sjshin.workers.dev/fr/" },
    { "source": "/zh", "destination": "https://calcmoa-i18n.sjshin.workers.dev/zh/" },
    { "source": "/zh/:path*", "destination": "https://calcmoa-i18n.sjshin.workers.dev/zh/:path*" },
    { "source": "/en/:path*", "destination": "https://calcmoa-i18n.sjshin.workers.dev/en/:path*" },
    { "source": "/ja/:path*", "destination": "https://calcmoa-i18n.sjshin.workers.dev/ja/:path*" },
    { "source": "/fr/:path*", "destination": "https://calcmoa-i18n.sjshin.workers.dev/fr/:path*" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    },
    {
      "source": "/css/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400" }]
    },
    {
      "source": "/js/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600" }]
    }
  ]
}
